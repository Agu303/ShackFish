{
  "name": "shackfish",
  "version": "1.5.1",
  "description": "Offline chess analysis with Stockfish",
  "author": "ShackFish",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "lucide": "1.72.0",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "local.shackfish.desktop",
    "productName": "ShackFish",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "ShackFish-Setup-${version}.${ext}"
    }
  }
}
